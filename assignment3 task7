#include <stdio.h>

int main()
{
    int votes[5000], count[13] = {0};
    int candidate[13];
    int candidates, n;
    int valid = 0, invalid = 0;
    int i, j, temp;

    printf("Enter number of candidates: ");
    scanf("%d", &candidates);

    printf("Enter number of votes: ");
    scanf("%d", &n);

    if (candidates < 1 || candidates > 12 ||
        n < 0 || n > 5000)
    {
        printf("Invalid input\n");
        return 0;
    }

    for (i = 1; i <= candidates; i++)
        candidate[i] = i;

    printf("Enter votes:\n");

    for (i = 0; i < n; i++)
    {
        scanf("%d", &votes[i]);

        if (votes[i] >= 1 && votes[i] <= candidates)
        {
            count[votes[i]]++;
            valid++;
        }
        else
            invalid++;
    }

    printf("Valid Votes = %d\n", valid);
    printf("Invalid Votes = %d\n", invalid);

    for (i = 1; i <= candidates - 1; i++)
    {
        for (j = i + 1; j <= candidates; j++)
        {
            if (count[i] < count[j])
            {
                temp = count[i];
                count[i] = count[j];
                count[j] = temp;

                temp = candidate[i];
                candidate[i] = candidate[j];
                candidate[j] = temp;
            }
        }
    }

    printf("\nCandidate Results:\n");

    for (i = 1; i <= candidates; i++)
        printf("Candidate %d = %d votes\n",
               candidate[i], count[i]);

    if (valid == 0)
        printf("No valid votes\n");
    else if (candidates > 1 && count[1] == count[2])
        printf("Election Result: Tie\n");
    else
        printf("Winner: Candidate %d\n", candidate[1]);

    return 0;
}
