#include <stdio.h>

int calls = 0;

int verify_card(int id)
{
    calls++;

    if (id % 3 == 0)
        return 1;

    return 0;
}

int main()
{
    int i, senior, eligible;
    int result1, result2;
    int calls1 = 0, calls2 = 0;

    for (i = 1; i <= 1000; i++)
    {
        senior = (i % 2 == 0);
        eligible = (i % 5 == 0);

        if ((senior && eligible) || verify_card(i))
            result1 = 1;
        else
            result1 = 0;
    }

    calls1 = calls;

    calls = 0;

    for (i = 1; i <= 1000; i++)
    {
        senior = (i % 2 == 0);
        eligible = (i % 5 == 0);

        if (verify_card(i) || (senior && eligible))
            result2 = 1;
        else
            result2 = 0;
    }

    calls2 = calls;

    printf("Calls in first order = %d\n", calls1);
    printf("Calls in second order = %d\n", calls2);

    return 0;
}
