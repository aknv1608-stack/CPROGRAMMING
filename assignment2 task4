#include <stdio.h>

char grade(int marks)
{
    if (marks < 0 || marks > 100)
        return '?';

    if (marks >= 90)
        return 'S';
    else if (marks >= 80)
        return 'A';
    else if (marks >= 70)
        return 'B';
    else if (marks >= 60)
        return 'C';
    else if (marks >= 50)
        return 'D';
    else
        return 'F';
}

int main()
{
    int marks[] = {100, 95, 83, 50, 49, -5};

    for (int i = 0; i < 6; i++)
    {
        printf("%d:%c ", marks[i], grade(marks[i]));
    }

    return 0;
}
