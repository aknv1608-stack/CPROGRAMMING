#include <stdio.h>

int globalToken = 1000;

extern int globalToken;

int next_token(void) {
    static int token = 1000;
    return ++token;
}

int auto_token(void) {
    int token = 1000;
    return ++token;
}

int extern_token(void) {
    return ++globalToken;
}

int main() {
    int s1, s2, s3;
    int a1, a2, a3;

    s1 = next_token();
    s2 = next_token();
    s3 = next_token();

    a1 = auto_token();
    a2 = auto_token();
    a3 = auto_token();

    printf("Static: %d %d %d\n", s1, s2, s3);
    printf("Auto: %d %d %d\n", a1, a2, a3);

    printf("Extern: %d %d %d\n",
           extern_token(),
           extern_token(),
           extern_token());

    printf("Register loop:\n");

    for (register int i = 1; i <= 3; i++) {
        printf("%d ", i);
    }

    return 0;
}
