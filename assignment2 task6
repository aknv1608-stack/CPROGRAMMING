#include <stdio.h>

int main()
{
    double balance, rate, repayment;
    double interest, total_interest = 0;
    double actual_payment;

    int month = 0;

    printf("Enter loan amount: ");
    scanf("%lf", &balance);

    printf("Enter monthly interest rate: ");
    scanf("%lf", &rate);

    printf("Enter monthly repayment: ");
    scanf("%lf", &repayment);

    if (balance <= 0 || rate < 0 || repayment <= 0)
    {
        printf("Invalid Input\n");
        return 0;
    }

    if (repayment <= balance * rate / 100)
    {
        printf("Loan cannot be repaid with this amount\n");
        return 0;
    }

    printf("\nMonth\tInterest\tPayment\t\tBalance\n");

    while (balance > 0.001)
    {
        month++;

        if (month > 360)
        {
            printf("Maximum limit reached\n");
            break;
        }

        interest = balance * rate / 100;

        total_interest += interest;

        balance += interest;

        actual_payment = repayment;

        if (actual_payment > balance)
            actual_payment = balance;

        balance -= actual_payment;

        printf("%d\t%.2lf\t\t%.2lf\t\t%.2lf\n",
               month, interest, actual_payment, balance);
    }

    if (balance <= 0.001)
    {
        printf("\nLoan Repaid Successfully\n");
        printf("Total Months = %d\n", month);
        printf("Total Interest = %.2lf\n", total_interest);
    }

    return 0;
}
